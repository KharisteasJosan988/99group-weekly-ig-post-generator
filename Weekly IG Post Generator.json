    {
      "parameters": {
        "jsCode": "const keywords = [\n\"properti\",\n\"rumah\",\n\"hunian\",\n\"perumahan\",\n\"apartemen\",\n\"kpr\",\n\"mortgage\",\n\"developer\",\n\"real estate\",\n\"cluster\",\n\"subsidi\",\n\"BTN\",\n\"FLPP\"\n];\n\nreturn $input.all().filter((item) => {\nconst text = (\n(item.json.title || \"\") +\n\" \" +\n(item.json.description || \"\") +\n\" \" +\n(item.json.contentSnippet || \"\")\n).toLowerCase();\nreturn keywords.some(keyword =>\ntext.includes(keyword.toLowerCase()));\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "ef250d00-1ede-42ba-897a-707d3037dedf",
      "name": "Filter Property News"
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\n\nreturn $input.all().filter(item => {\n\n  const title = (item.json.title || \"\").trim().toLowerCase();\nif (seen.has(title)) {\nreturn false;\n\n}\n\nseen.add(title);\n\nreturn true;\n\n});"
      },
